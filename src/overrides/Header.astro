---
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import { Image } from 'astro:assets';
import gaiaLogo from '../assets/gaia-logo.svg';

const WEB = 'https://gaiareact.com';
const NAV = [
	{ href: `${WEB}/why/`, label: 'Why GAIA' },
	{ href: `${WEB}/features/`, label: 'Features' },
	{ href: '/', label: 'Docs', active: true },
	{ href: `${WEB}/about/`, label: 'About' },
];

const shouldRenderSearch =
	config.pagefind ||
	config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="gaia-header">
	<div class="gaia-header__left">
		<a class="gaia-header__logo" href={WEB} aria-label="GAIA, home">
			<Image src={gaiaLogo} alt="GAIA" height={24} />
		</a>

		<nav class="gaia-header__nav" aria-label="Main navigation">
			{NAV.map((item) => (
				<a
					class="gaia-header__nav-link"
					class:list={[{ 'gaia-header__nav-link--active': item.active }]}
					href={item.href}
					aria-current={item.active ? 'page' : undefined}
				>
					{item.label}
				</a>
			))}
		</nav>
	</div>

	<div class="gaia-header__search print:hidden">
		{shouldRenderSearch && <Search />}
	</div>

	<div class="gaia-header__right print:hidden">
		<a
			class="gaia-header__github"
			href="https://github.com/gaia-react/gaia"
			rel="noopener noreferrer"
			target="_blank"
			aria-label="GitHub"
		>
			<svg aria-hidden="true" fill="currentColor" height="15" viewBox="0 0 24 24" width="15">
				<path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
			</svg>
			<span>GitHub</span>
		</a>
		<a class="gaia-header__cta" href={`${WEB}/get-started/`}>Get Started</a>
	</div>
</div>

<style>
	.gaia-header {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1.5rem;
		height: 100%;
		width: 100%;
		padding-inline: 1rem;
	}

	@media (min-width: 40rem) {
		.gaia-header {
			padding-inline: 2rem;
		}
	}

	.gaia-header__left {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		min-width: 0;
	}

	.gaia-header__logo {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}
	.gaia-header__logo :global(img) {
		height: 1.5rem;
		width: auto;
	}

	.gaia-header__nav {
		display: none;
		align-items: center;
		gap: 0.125rem;
	}

	.gaia-header__nav-link {
		color: var(--gaia-ink-dim, #b0aea5);
		font-family: var(--gaia-font-body);
		font-size: 0.8125rem;
		letter-spacing: 0.02em;
		white-space: nowrap;
		text-decoration: none;
		padding: 0.375rem 0.625rem;
		border-radius: 2px;
		transition: color 150ms;
	}
	.gaia-header__nav-link:hover {
		color: var(--gaia-accent, #d97757);
	}
	.gaia-header__nav-link--active {
		color: var(--gaia-accent, #d97757);
	}

	.gaia-header__search {
		display: flex;
		justify-content: center;
		min-width: 0;
	}

	.gaia-header__right {
		display: none;
		align-items: center;
		gap: 0.5rem;
	}

	.gaia-header__github {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		color: var(--gaia-ink-dim, #b0aea5);
		font-size: 0.8125rem;
		letter-spacing: 0.02em;
		text-decoration: none;
		padding: 0.375rem 0.625rem;
		border-radius: 2px;
		transition: color 150ms;
		white-space: nowrap;
	}
	.gaia-header__github:hover {
		color: var(--gaia-ink, #faf9f5);
	}

	.gaia-header__cta {
		display: inline-flex;
		align-items: center;
		background-color: var(--gaia-accent, #d97757);
		color: var(--gaia-canvas, #141413);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-decoration: none;
		padding: 0.4375rem 0.875rem;
		border-radius: 2px;
		white-space: nowrap;
		transition: background-color 150ms;
	}
	.gaia-header__cta:hover {
		background-color: var(--gaia-accent-2, #c96442);
	}

	@media (min-width: 50rem) {
		.gaia-header__nav,
		.gaia-header__right {
			display: flex;
		}
	}

	/* Hand the search element a sensible width without fighting Starlight. */
	.gaia-header__search :global(site-search) {
		width: 100%;
		max-width: 22rem;
		margin-inline: auto;
	}
</style>
