---
// Context bands drawn on a 0-100% bar per window size, as static SVG at build
// time. Band labels alternate above and below the bar so close marks don't
// collide. The band table on the page carries the exact figures; this shows
// where they sit against the whole window.

interface Mark {
	label: string;
	at: number;
}

interface Row {
	label: string;
	total: number;
	// In order: yellow, red, fire, skull. Each starts a zone that runs to the next.
	bands: Mark[];
	compact: Mark;
}

interface Props {
	title: string;
	description: string;
	rows: Row[];
}

const { title, description, rows } = Astro.props;

const LABEL_W = 104;
const BAR_W = 560;
const BAR_H = 16;
const ROW_H = 92;
const BAR_TOP = 36;
const PAD = 8;
const width = PAD * 2 + LABEL_W + BAR_W;
const height = PAD * 2 + rows.length * ROW_H;
const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const x = (row: Row, at: number) => PAD + LABEL_W + (at / row.total) * BAR_W;
---

<figure class="band-scale">
	<div class="scroll">
		<svg
			viewBox={`0 0 ${width} ${height}`}
			role="img"
			aria-labelledby={`${slug}-title ${slug}-desc`}
			style={`min-width: 560px; max-width: ${width}px`}
		>
			<title id={`${slug}-title`}>{title}</title>
			<desc id={`${slug}-desc`}>{description}</desc>
			{rows.map((row, rowIndex) => {
				const top = PAD + rowIndex * ROW_H;
				const barY = top + BAR_TOP;
				const compactX = x(row, row.compact.at);
				return (
					<g>
						<text x={PAD} y={barY + BAR_H - 3} class="row-label">
							{row.label}
						</text>
						<rect x={PAD + LABEL_W} y={barY} width={BAR_W} height={BAR_H} rx="3" class="track" />
						{row.bands.map((band, index) => {
							const end = row.bands[index + 1]?.at ?? row.total;
							return (
								<rect
									x={x(row, band.at)}
									y={barY}
									width={x(row, end) - x(row, band.at)}
									height={BAR_H}
									class={`zone zone-${index}`}
								/>
							);
						})}
						{row.bands.map((band, index) => {
							const bx = x(row, band.at);
							const above = index % 2 === 0;
							return (
								<g>
									<line x1={bx} x2={bx} y1={above ? barY - 6 : barY} y2={above ? barY + BAR_H : barY + BAR_H + 6} class="tick" />
									<text x={bx} y={above ? barY - 10 : barY + BAR_H + 20} text-anchor="middle" class="mark">
										{band.label}
									</text>
								</g>
							);
						})}
						<line x1={compactX} x2={compactX} y1={barY - 6} y2={barY + BAR_H + 6} class="tick compact" />
						<text x={Math.min(compactX, PAD + LABEL_W + BAR_W)} y={barY - 10} text-anchor="end" class="mark compact-label">
							{row.compact.label}
						</text>
					</g>
				);
			})}
		</svg>
	</div>
	<figcaption>{title}</figcaption>
</figure>

<style>
	.band-scale {
		margin: 1.5rem 0;
	}
	.scroll {
		overflow-x: auto;
	}
	svg {
		display: block;
		width: 100%;
		height: auto;
		font-family: var(--gaia-font-body);
	}
	figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--gaia-muted);
	}
	.row-label {
		font-size: 13px;
		fill: var(--gaia-ink);
	}
	.track {
		fill: var(--gaia-surface-raised);
		stroke: var(--gaia-line);
	}
	.zone-0 {
		fill: var(--gaia-warn-soft);
	}
	.zone-1 {
		fill: var(--gaia-accent);
	}
	.zone-2 {
		fill: var(--gaia-accent-2);
	}
	.zone-3 {
		fill: var(--sl-color-accent-low);
	}
	.tick {
		stroke: var(--gaia-ink-dim);
		stroke-width: 1.5;
	}
	.compact {
		stroke-dasharray: 3 3;
	}
	.mark {
		font-size: 12px;
		fill: var(--gaia-ink);
	}
	.compact-label {
		fill: var(--gaia-ink-dim);
	}
</style>
