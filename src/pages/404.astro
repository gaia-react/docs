---
import { Image } from 'astro:assets';
import gaiaLogo from '../assets/gaia-logo.svg';

const WEB = 'https://gaiareact.com';
const NAV = [
	{ href: `${WEB}/why/`, label: 'Why GAIA' },
	{ href: `${WEB}/features/`, label: 'Features' },
	{ href: `${WEB}/about/`, label: 'About' },
	{ href: '/', label: 'Docs', active: true },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>404 — GAIA Docs</title>
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<header>
			<div class="header-inner">
				<div class="header-left">
					<a class="logo-link" href={WEB} aria-label="GAIA, home">
						<Image src={gaiaLogo} alt="GAIA" height={24} />
					</a>
					<nav aria-label="Main navigation">
						{NAV.map((item) => (
							<a
								class:list={['nav-link', { 'nav-link--active': item.active }]}
								href={item.href}
								aria-current={item.active ? 'page' : undefined}
							>
								{item.label}
							</a>
						))}
					</nav>
				</div>
				<div class="header-right">
					<a class="cta" href={`${WEB}/get-started/`}>Get Started</a>
				</div>
			</div>
		</header>
		<main>
			<span class="code">404</span>
			<h1>Page not found.</h1>
			<a class="home-link" href="/">Go to docs home</a>
		</main>
	</body>
</html>

<style>
	:root {
		color-scheme: dark;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background-color: #141413;
		color: #faf9f5;
		font-family: ui-sans-serif, system-ui, sans-serif;
	}

	header {
		position: fixed;
		inset-block-start: 0;
		inset-inline: 0;
		height: 4rem;
		background-color: rgba(20, 20, 19, 0.85);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid #3d3d3a;
		z-index: 10;
	}

	.header-inner {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 1.5rem;
		height: 100%;
		padding-inline: 1rem;
	}

	@media (min-width: 40rem) {
		.header-inner {
			padding-inline: 2rem;
		}
	}

	.header-left {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		min-width: 0;
	}

	.logo-link {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	.logo-link img {
		height: 1.5rem;
		width: auto;
	}

	nav {
		display: none;
		align-items: center;
		gap: 0.125rem;
	}

	@media (min-width: 50rem) {
		nav {
			display: flex;
		}
	}

	.nav-link {
		color: #b0aea5;
		font-size: 0.8125rem;
		letter-spacing: 0.02em;
		white-space: nowrap;
		text-decoration: none;
		padding: 0.375rem 0.625rem;
		border-radius: 2px;
		transition: color 150ms;
	}

	.nav-link:hover {
		color: #d97757;
	}

	.nav-link--active {
		color: #d97757;
	}

	.header-right {
		display: none;
		align-items: center;
	}

	@media (min-width: 50rem) {
		.header-right {
			display: flex;
		}
	}

	.cta {
		display: inline-flex;
		align-items: center;
		background-color: #d97757;
		color: #141413;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-decoration: none;
		padding: 0.4375rem 0.875rem;
		border-radius: 2px;
		white-space: nowrap;
		transition: background-color 150ms;
	}

	.cta:hover {
		background-color: #c96442;
	}

	main {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding-top: 4rem;
		padding-inline: 1.5rem;
	}

	.code {
		display: block;
		font-family: 'Fraunces', Georgia, serif;
		font-weight: 300;
		font-size: clamp(5rem, 15vw, 9rem);
		letter-spacing: -0.02em;
		line-height: 1;
		color: #faf9f5;
		margin-bottom: 1.5rem;
	}

	h1 {
		font-family: 'Fraunces', Georgia, serif;
		font-weight: 300;
		font-size: clamp(1.25rem, 4vw, 2rem);
		letter-spacing: -0.02em;
		line-height: 1.15;
		color: #faf9f5;
		margin: 0 0 2rem;
	}

	.home-link {
		display: inline-flex;
		align-items: center;
		background-color: #d97757;
		color: #141413;
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-decoration: none;
		padding: 0.5rem 1.25rem;
		border-radius: 2px;
		transition: background-color 150ms;
	}

	.home-link:hover {
		background-color: #c96442;
	}
</style>
